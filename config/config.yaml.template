# Configuration for FinnGen 3 Olink Analysis Pipeline (Refactored Version)
# This template should be customized for your specific data and environment

# Batch configuration
# In single-batch mode, use the 'data' section below
# In multi-batch mode, use the 'batches' section with batch-specific data paths
batch:
  # Current batch being processed (set by pipeline runner in multi-batch mode)
  current_batch_id: null  # e.g., "batch_01", "batch_02"
  # Default batch identifier for single-batch mode
  default_batch_id: "batch_01"  # Used when multi_batch_mode: false

# Data paths (used in single-batch mode or as fallback)
# NOTE: Starting point is pre-filtered NPX matrix with AG samples already removed
data:
  npx_matrix_file: "/path/to/npx_matrix_all_2527_samples_fg3_batch_02.parquet"  # REQUIRED: Pre-filtered NPX matrix (AG samples removed)
  metadata_file: "/path/to/metadata.tsv"  # REQUIRED: Sample metadata file
  bridging_samples_file: "/path/to/bridging_samples.csv"  # Optional: Bridging sample information
  bridging_samples_finngenid_map: "/path/to/bridging_finngenid_map.tsv"  # Optional: EA5 to FG3 FINNGENID mapping

# Batch-specific data paths (used in multi-batch mode)
# Each batch section contains batch-specific input file paths
# Global thresholds and parameters are defined in the 'parameters' section
batches:
  batch_01:
    batch_id: "batch_01"
    batch_designation: "fg3_batch_01"  # Suffix used in output filenames
    data:
      npx_matrix_file: "/path/to/batch_01_npx_matrix.parquet"
      metadata_file: "/path/to/batch_01_metadata.tsv"
      bridging_samples_file: null  # Optional
      bridging_samples_finngenid_map: null  # Optional
  batch_02:
    batch_id: "batch_02"
    batch_designation: "fg3_batch_02"  # Suffix used in output filenames
    data:
      npx_matrix_file: "/path/to/batch_02_npx_matrix.parquet"
      metadata_file: "/path/to/batch_02_metadata.tsv"
      bridging_samples_file: "/path/to/bridging_samples.csv"  # Optional
      bridging_samples_finngenid_map: "/path/to/bridging_finngenid_map.tsv"  # Optional
  batch_03:
    batch_id: "batch_03"
    batch_designation: "fg3_batch_03"  # Suffix used in output filenames
    data:
      # Produced by scripts/00a_ingest_vendor_npx.R from the vendor Extended NPX long-format delivery.
      # Do NOT point this at the raw vendor file: Step 00 would dcast it but then rebuild its long
      # representation from the wide matrix, fabricating SampleQC/AssayQC/SampleType and discarding
      # PlateID, WellID, the QC counters and the OSI columns. Run 00a first.
      npx_matrix_file: "/path/to/00a_npx_matrix_raw_fg3_batch_03.rds"
      # Batch 03 has no provider cohort/metadata TSV. The THL plate-2 volumes file supplies biobank,
      # collection/processing/freezing timestamps, barcode, freeze-thaw, hemolysis, volume and plate
      # position for 5,331 of 6,191 samples; the 860 P1516_* samples have no THL metadata at all.
      metadata_file: "/path/to/finngen_proteomics3_final_data_plate2_volumes.txt"
      # SampleID -> FINNGENID crosswalk. Required: batch 03 SampleIDs span two namespaces
      # (P + 20 digits, and the Broad P1516_* collection IDs) and carry a "-rep" technical-replicate
      # suffix that must be stripped before lookup.
      sample_id_map_file: "/path/to/finngen_proteomics3_combined_SampleID_FinngenID.txt"
      bridging_samples_file: "/path/to/FG_cross_batch_bridging_metadata.tsv"
      bridging_samples_finngenid_map: null
      # Sample-level ancillary tables emitted by step 00a
      sample_index_file: "/path/to/00a_sample_index_fg3_batch_03.tsv"
      assay_inventory_file: "/path/to/00a_assay_inventory_fg3_batch_03.tsv"
      # Registry-derived disease-group eligibility (NOT provider selection lists - see protocol 5.6b)
      disease_group_eligibility_file: "/path/to/fg3_batch03_disease_group_eligibility_DERIVED_v1.tsv"
      # SampleIDs hard-excluded on consent grounds, one per line
      withdrawal_list_file: "/path/to/withdrawals_fg3_batch_03.txt"

# Covariate and kinship paths
covariates:
  # Genotype release these resources come from. Recorded in outputs so a release can never be
  # ambiguous about which FinnGen data freeze its genetic QC was run against.
  genotype_release: "R14"  # e.g. "R13", "R14"
  kinship_file: "/path/to/kinship_matrix.kin0"  # Kinship matrix file
  # Primary covariate file (genetic PCs, age, sex, BMI, smoking).
  # For R14 use gs://r14-data/pheno/R14_COV_V0.FID.txt.gz - it carries BL_AGE, SEX, SEX_IMPUTED,
  # HEIGHT, WEIGHT, BMI, SMOKE2/3/5, SMOKE_AGE and PC1-PC20 in a single file, so the bespoke
  # R13_COV_PHENO_V0_WITH_SMOKING derivation used for R13 is not needed.
  covariate_file: "/path/to/covariates.txt.gz"
  # Fallback file for sex information (used when FINNGENID not found in covariate_file).
  # R14 equivalent: gs://r14-data/fg-analysis-r_resources/finngen_R14_minimum_extended_1.0.parquet
  finngen_r13_minimum_file: "/path/to/finngen_minimum.txt.gz"  # Optional: Fallback for sex information
  # Optional: restrict to the release's actual analysis set
  inclusion_list_file: null  # e.g. "/path/to/finngen_R14_finngenid_actual_inclusion_list.txt"

# Output directories
# All paths are relative to base_dir or can use environment variable PIPELINE_OUTPUT_DIR
output:
  base_dir: "output"  # Base output directory (can be overridden by PIPELINE_OUTPUT_DIR env var)
  qc_dir: "qc"
  outliers_dir: "outliers"
  normalized_dir: "normalized"
  phenotypes_dir: "phenotypes"
  pqtl_dir: "pqtl"
  reports_dir: "reports"
  logs_dir: "logs"

# Analysis parameters
parameters:
  # QC thresholds
  qc:
    max_missing_per_sample: 0.10  # Max 10% missing data per sample
    max_missing_per_protein: 0.10  # Max 10% missing data per protein
    min_sample_call_rate: 0.90
    min_protein_call_rate: 0.90
    remove_control_probes: true  # Remove control probes (Incubation, Extension, Amplification) from biological-only outputs (default: true)
    # Assays the vendor excluded at batch release. These arrive with Count == 0 and NPX/PCNormalizedNPX
    # all NaN, so the missingness filter would drop them anyway; naming them makes the removal explicit
    # and logged in one place. Leave as [] when the delivery excluded nothing.
    vendor_excluded_assays: []  # e.g. ["ACTR5", "BCLAF1", "CRYM"]
    # Remove samples with no genetic sex. Sex-outlier detection cannot evaluate them, so leaving them in
    # would mean publishing samples that silently bypassed one QC method.
    remove_missing_genetic_sex: true

  # Sample handling
  sample_handling:
    # Preserve repeat/serial measurements of the same individual.
    # When true: duplicate-FINNGENID collapse and best-quality-per-individual selection are DISABLED,
    # released matrices stay indexed by SampleID (FINNGENID is not unique), and kinship is reported as a
    # relationship table plus a recommended unrelated subset WITHOUT removing rows.
    # Required for longitudinal batches. Batch 03 has ~1,556 repeat samples across 1,477 individuals.
    preserve_repeat_samples: false
    # Technical-replicate SampleID suffix. When set, "<SampleID><suffix>" resolves to the FINNGENID of
    # the base SampleID and the row is flagged is_technical_replicate. Unset (null) means such IDs fail
    # to resolve and are dropped - the failure mode that lost 50 EA5 bridge samples in batch 02.
    technical_replicate_suffix: null  # e.g. "-rep"
    # Partition rule for samples that cannot be mapped to a FinnGen ID.
    # "separate_deliverable": route them to their own output directory (they are not FinnGen data)
    # "drop": remove silently (legacy behaviour, not recommended)
    unmappable_sample_policy: "separate_deliverable"
    # Optional attribute-only tagging of a separate-project subset. These samples REMAIN in the main
    # release when they have mappable FinnGen IDs; the tag travels in the metadata schema and drives a
    # convenience extract. Use when a biobank has selected a subset for a distinct study.
    separate_project:
      enabled: false
      label: null            # e.g. "ArcticBiobank"
      selector_column: null  # metadata column to match on, e.g. "BIOBANK"
      selector_values: []    # e.g. ["Arctic Biobank"]

  # Olink Sample Index (OSI) - present from NPX Map 2.0.0 onward
  osi:
    # Carry OSI as covariates and as a reported QC flag.
    enabled: true
    # OSI fields to expose as adjustable covariates
    covariates:
      - OSISummary
      - OSITimeToCentrifugation
      - OSIPreparationTemperature
    # Flag samples in the worst OSI category. Reported in the QC table either way.
    flag_category: 4
    # Whether the flag REMOVES samples. Keep false until the index is calibrated against a batch with a
    # known ground truth: the worst category can cover a large share of a delivery (17.6% in batch 03),
    # and OSI directionality is not yet corroborated against Olink documentation.
    remove_flagged: false

  # Outlier detection
  outliers:
    pca_components: 10
    pca_sd_threshold: 3  # Standard deviations for PCA outlier
    zscore_threshold: 4  # Z-score threshold for outlier detection
    sex_outlier_method: "protein_based"  # or "genetic_based"
    # Sex outlier handling mode:
    # - "strict_only": Only flag and remove TIER 1 strict mismatches (predicted_sex != genetic_sex)
    #                  TIER 2 threshold-based outliers are kept in the dataset
    # - "all": Flag and remove both TIER 1 strict mismatches AND TIER 2 threshold-based outliers (default)
    sex_outlier_mode: "all"  # Options: "strict_only" or "all"
    run_nn: true  # Whether to run the MLP neural network
    run_autoencoder: true  # Whether to run the Autoencoder+Classifier model
    run_svm: true  # Whether to run the Support Vector Machine model
    top_n_proteins_nn: 150  # Number of top proteins for NN models

  # pQTL outlier detection (Step 05b)
  pqtl_outliers:
    finemap_path: "gs://path/to/finemap/summary/"  # GCS path to pQTL finemap results
    genotype_path: "gs://path/to/genotype/data"  # GCS path to PLINK genotype data
    z_threshold: 4  # Legacy threshold (not currently used)
    per_variant_z_threshold: 3  # Threshold for per-variant outlier detection (|Z| > threshold)
    sex_chromosome_pQTLs: false  # Set to true to include X-chromosome variants
    top_n_pQTLs: 200  # Number of top pQTLs to use for Z-score calculation (fallback when no pQTL list provided)
    min_maf_for_selection: 0.05  # Minimum MAF threshold for pQTL selection
    use_consensus_pqtls: true  # Use LASSO-selected consensus pQTLs from Step 05a (if training enabled)
    # Optional: Provide a pre-computed pQTL list file when training is disabled
    # File should contain one column: 'rsid' (or 'variant' or 'variant_id'), or be a single-column file with rsids
    # This takes precedence over consensus pQTLs from training and top_n selection
    provided_pqtl_list_file: null  # e.g., "/path/to/pqtl_list.tsv" - Optional: Path to provided pQTL list file
    cache_genotypes: true  # Cache extracted BAM files to avoid re-downloading
    apply_irn: true  # Apply Inverse Rank Normalization before z-score calculation

    # Robust residual-based outlier detection parameters
    residual_detection:
      enabled: true
      min_variants: 100  # Minimum variants required per sample
      use_composite_score: true
      tier1_percentile: 0.92  # High-confidence outliers
      tier2_percentile: 0.80  # Moderate-confidence
      tier3_percentile: 0.65  # Low-confidence

  # Normalization (Step 06)
  normalization:
    method: "bridge_normalization"  # or "median_normalization"
    # Reference batch ID for bridge normalization (required when multi_batch_mode: true)
    # This batch will be processed first and used as reference for other batches
    reference_batch: "batch_01"  # e.g., "batch_01", "batch_02" - must match a batch ID in 'batches' section
    run_enhanced_bridge: false  # Step 07: Run enhanced bridge normalization
    enhanced_bridge_input: "raw"  # Input for step 07: "raw" or "step06_median"
    # Set to true when integrating multiple batches (requires 'batches' section to be configured)
    multi_batch_mode: false  # When true, pipeline processes batches sequentially with reference batch first

  # Cross-batch bridge normalization (Step 07)
  bridge_normalization:
    # Reference batch for Olink standard normalization (unchanged during normalization)
    # If null, will default to larger batch or batch with better QC
    reference_batch: "batch_02"  # Options: "batch_01", "batch_02", or null for auto-selection
    # Normalization method: "olink_standard" (default, adjusts only non-reference) or "combined_reference" (adjusts both)
    method: "olink_standard"
    # Per-protein bridgeability plots: list of protein names/OlinkIDs to generate detailed QC plots
    # If empty list [], no bridgeability plots will be generated
    # Example: ["IL6", "TNF", "OID40770", "MST1", "LAIR2"]
    bridgeability_proteins: []  # List of proteins for per-protein bridgeability assessment
    # Optional: exclude specific bridging sample IDs from both normalisation (07) and KPI (07b)
    # List SampleIDs to remove. Leave as empty list [] to include all bridging samples.
    # Example: ["SAMPLE_001", "SAMPLE_002"]
    exclude_bridge_sample_ids: []
    # Post-hoc KPI evaluation of harmonisation efficacy (Step 07b)
    # Computes distance metrics, noise floor ratio, kBET, LISI, biology preservation, and outlier detection
    run_kpi_evaluation: false  # Set to true to run cross-batch harmonisation KPI after step 07

  # KPI evaluation parameters (Step 07b)
  kpi:
    # PCA configuration for fixed basis (trained on pre-harmonisation combined data)
    pca_max_pcs: 50  # Maximum number of principal components to retain
    pca_var_threshold: 0.95  # Cumulative variance threshold (0.95 = 95% variance explained)
    # NA handling policy: complete-case preferred; impute only if missingness is very low
    na_impute_overall_max_frac: 0.001  # Maximum missingness fraction (0.1%) to allow median imputation
    complete_case_pca_min_rows: 200  # Minimum complete rows required for complete-case PCA

  # Aggregation (only used when multi_batch_mode: true)
  aggregation:
    aggregate_output: false  # Set to true to aggregate batches in steps 09-11

  # Age association analysis (Step 08)
  age_association:
    use_multicollinearity_aware: true  # Use stepwise regression for correlated proteins
    protein_correlation_threshold: 0.80  # Correlation threshold for grouping
    sd_filter_threshold: 3  # SD threshold for filtering extreme effect sizes

  # pQTL analysis
  pqtl:
    kinship_threshold: 0.0884  # Standard KING threshold for 3rd degree relatives
    num_pcs: 10  # Number of PCs to include as covariates
    maf_threshold: 0.30
    hwe_threshold: 1e-6

  # Covariate adjustment (Step 08)
  covariate_adjustment:
    # Set to false to skip adjustment: Step 08 copies 06/07 normalized matrix to 08 output path and exits.
    # Use for single-batch runs when no covariate adjustment is desired (e.g. --from 05d --to 11).
    enabled: true
    # List of covariates to adjust for (default: age and sex only)
    # Available options: age, sex, bmi, smoking
    # Note: Proteomic PCs (pPC1-10) are NOT adjusted for to preserve biological signal
    covariates_to_adjust:
      - age
      - sex
    # Legacy boolean flags (deprecated, use covariates_to_adjust list instead)
    adjust_for_age: true
    adjust_for_sex: true
    adjust_for_bmi: false
    adjust_for_smoking: false
    adjust_for_pcs: false  # Proteomic PCs are never adjusted (preserve biological signal)
    n_pcs_to_adjust: 10  # Not used (proteomic PCs excluded from adjustment)
    # Batch correction (multi-batch mode only, applied during Step 09 aggregation)
    # When true, regresses out residual batch effect per protein in the aggregate matrix.
    # Produces additional batch-corrected per-batch NPX matrices alongside the aggregate.
    # Only relevant when multi_batch_mode is true and aggregation is enabled.
    # Default: false (opt-in).
    adjust_for_batch: false

  # Kinship filtering (Step 10)
  kinship_filtering:
    kinship_threshold: 0.0884  # KING kinship threshold for relatedness filtering

# Platform specifications
platform:
  name: "Olink Explore HT"
  num_proteins: 5440
  num_plates: 30
  samples_per_plate: 86

# Special cohorts to track
cohorts:
  disease_cohorts:
    - "Kidney"
    - "Parkinsons"
    - "Metabolic"
    - "AMD"
    - "Rheuma"
    - "Pulmo"
    - "Chromosomal_Abnormalities"
  special_samples:
    - "Blood_donors"
    - "Bridging_samples"
    - "Kids"
    - "F64"
    - "MFGE8"

### AUXILIARY CONFIGURATIONS ###
### PRODUCTION RUN DOES NOT NEED THESE CONFIGURATIONS AND CAN BE IGNORED ###

# pQTL Training configuration (Step 05a)
# Uses LASSO logistic regression to select most informative pQTLs
pqtl_training:
  enabled: false  # Set to true to run pQTL training before production detection
  output_dir: "pqtl-training"  # Subdirectory in output base_dir

  # Stability Selection Parameters
  n_features_to_sample: 500  # Number of features to randomly sample per cohort
  n_top_tier_pool: 1000      # Size of the top-tier pool to sample from
  selection_threshold: 0.01  # Frequency threshold for consensus (1%)

  # LASSO parameters
  lasso:
    alpha: 1.0  # 1.0 = LASSO, 0.0 = Ridge, 0-1 = Elastic Net
    cv_folds: 10  # Cross-validation folds for lambda selection
    lambda_selection: "lambda.min"  # "lambda.min" or "lambda.1se"

  # Multi-cohort training for robustness
  num_training_seeds: 250
  error_configs:
    - genotype_mismatch: 20
      sex_mismatch: 5
    - genotype_mismatch: 30
      sex_mismatch: 10
    - genotype_mismatch: 40
      sex_mismatch: 15
    - genotype_mismatch: 50
      sex_mismatch: 20
  cohort_size: 1000

  # Threshold optimization
  threshold_method: "youden_j"  # "youden_j" or "fixed_specificity"
  mad_k: 3.0  # Multiplier for MAD-based threshold backup

  # Cohorts to exclude from training
  excluded_cohorts:
    - "Chromosomal_Abnormalities"
    - "F64"
    - "Kids"

# Test case configuration (Step 05c - Provenance Test)
test_case:
  enabled: true  # Enable test case mode for governance testing
  random_seed: 12345  # Random seed for reproducibility
  output_dir: "test-case"  # Subdirectory in output base_dir

  # Cohort downsampling configuration
  cohort:
    min_size: 500
    max_size: 2000
    default_size: 1000

  # Error introduction configuration
  error_samples:
    category1_within_sex_id_shuffle: 20    # Within-sex FINNGENID swaps
    category2_sex_label_misannotation: 10  # Sex label only
    category3_cross_sex_id_shuffle: 5      # Cross-sex FINNGENID swaps

  # Genetic distance stratification
  genetic_distance:
    enabled: true
    use_precomputed_gPCs: true
    n_pcs: 4
    distance_metric: "euclidean"
    percentile_strategy: "mixed"
    percentile_75_fraction: 0.6
    percentile_90_fraction: 0.4
    auto_lower_threshold: true
    log_warnings: true

  validation:
    strict_mode: true
    generate_plots: true
    verbose_logging: true

  # pQTL selection for governance test
  pqtl_selection:
    min_maf: 0.30  # Minimum MAF threshold
    max_pqtls: null  # Maximum number of pQTLs (null = use all)




